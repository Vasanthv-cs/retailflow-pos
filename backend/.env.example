# ==============================================================================
# RetailFlow POS Backend — Production & Development Environment Template
# ==============================================================================
# Configure these variables directly in the Render.com Dashboard:
# Service > Environment > Add Environment Variable.
# NEVER commit production passwords or JWT secrets to version control.
# ==============================================================================

# Server Profile & Ingress Port (Render sets PORT automatically)
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# TiDB Cloud Serverless / MySQL Database Connection
# ------------------------------------------------------------------------------
# 1. Full JDBC URL with TLS verification:
SPRING_DATASOURCE_URL=jdbc:mysql://<tidb-host>:4000/retailflow?sslMode=VERIFY_IDENTITY&useSSL=true&serverTimezone=Asia/Kolkata

# 2. TiDB Cloud Username (e.g. 2AbcDeFgh.root):
SPRING_DATASOURCE_USERNAME=your_tidb_username_here

# 3. TiDB Cloud Password:
SPRING_DATASOURCE_PASSWORD=your_tidb_password_here

# Connection Pool (Optimized for Render 512MB RAM free tier)
DB_POOL_MAX=10
DB_POOL_MIN=2

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Generate a cryptographically random 256-bit (minimum 32-64 characters) secret key
JWT_SECRET=GENERATE_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_256_BIT_SECRET_KEY_MINIMUM_32_CHARS
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
# Comma-separated list of your Cloudflare Pages and local origins (NO trailing slashes)
CORS_ALLOWED_ORIGINS=https://retailflow-pos.pages.dev,http://localhost:5173

# Initial Bootstrap Administrator (created safely on first boot if no admin exists)
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_EMAIL=admin@retailflow.in
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_UPON_DEPLOYMENT!
INITIAL_ADMIN_CODE=ADMIN-001
