# ==============================================================================
# RetailFlow POS Backend — Production & Development Environment Template
# ==============================================================================
# Copy this file to `.env` for local testing or configure these variables
# directly in the Railway project dashboard under Service > Variables.
# NEVER commit production passwords or JWT secrets to version control.
# ==============================================================================

# Server Profile & Port
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Connection (Railway MySQL provides MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE)
MYSQLHOST=mysql.railway.internal
MYSQLPORT=3306
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=YOUR_SECURE_RAILWAY_DATABASE_PASSWORD_HERE

# Full JDBC URL (Optional override; if set, takes precedence)
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql.railway.internal:3306/railway?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata

# Connection Pool Limits
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT Authentication
# Generate a cryptographically random 256-bit (minimum 32 characters) secret key
JWT_SECRET=GENERATE_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_256_BIT_SECRET_KEY_MINIMUM_32_CHARS
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
# Comma-separated list of your Vercel production and preview domains (NO trailing slashes)
CORS_ALLOWED_ORIGINS=https://your-retailflow-app.vercel.app,https://your-retailflow-preview.vercel.app

# Initial Bootstrap Administrator (created safely on first boot if no admin exists)
INITIAL_ADMIN_NAME="Store Administrator"
INITIAL_ADMIN_EMAIL=admin@retailflow.in
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_UPON_DEPLOYMENT!
INITIAL_ADMIN_CODE=ADMIN-001
